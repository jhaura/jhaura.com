{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jhaura-com",
  "compatibility_date": "2026-09-01",
  "account_id": "3d9ffaf2f02e82e572f9990c4bbdfe5c",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "www.jhaura.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true
  }
}
